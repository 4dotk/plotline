cache/llm_replay.jsonl
cache/llm_replay_gemma_e4b.jsonl
# raw coverage data and the scratch sweep written by scripts/coverage_by_layer.py
results/adequacy/.coverage*
results/adequacy/mt_run/

# drafts and scratch files from other agents, not part of the submission
temp/
