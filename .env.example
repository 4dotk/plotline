# LLM provider
LLM_TYPE=LOCAL

# Execution mode: live, replay, or off
LLM_MODE=live

# Logical model name used in replay-cache keys; identical on every machine.
# Change it whenever the GGUF file or its quantisation changes.
LLM_MODEL_TAG=gemma-4-e4b-it-q4_k_m

# Local llama-server (OpenAI-compatible endpoint); used by live mode only
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_MODEL=gemma-4-e4b
LLM_API_KEY=

# Generation settings (temperature must be 0). gemma-4 thinks before answering and its
# reasoning counts against max tokens: 256 is too small (empty answer, finish_reason=length).
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024

# Replay cache. Only the canonical machine sets LLM_CACHE_WRITE=1.
LLM_CACHE_PATH=cache/llm_replay.jsonl
LLM_CACHE_WRITE=0

# Run record for metadata.llm (required in live mode)
LLM_BACKEND=llama serve
# Model: unsloth/gemma-4-E4B-it-GGUF, file gemma-4-E4B-it-Q4_K_M.gguf
LLM_BUILD=0.6.0-dev build 11429 (commit d81235049)
LLM_LAUNCH_FLAGS=--ctx-size 8192 --threads 6 --sleep-idle-seconds 900 --mmproj mmproj-BF16.gguf
LLM_GGUF_SHA256=85a896a047553e842f25297ee5b031d64ff30147d9c4af17b1e4b394cd1fab87
LLM_QUANT=Q4_K_M
LLM_CTX=8192
